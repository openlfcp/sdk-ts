{
  "name": "@openlfcp/core",
  "version": "0.1.0-rc.1",
  "description": "Identifiers, shared protocol types, errors and byte helpers for LFCP.",
  "keywords": [
    "openlfcp",
    "lfcp",
    "local-first",
    "end-to-end-encryption",
    "identifiers",
    "errors",
    "bytes"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/openlfcp/sdk-ts/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/openlfcp/sdk-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openlfcp/sdk-ts.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
