{
  "name": "@openlfcp/storage-idb",
  "version": "0.2.0-beta.2",
  "description": "Durable portable storage for LFCP clients on IndexedDB (browsers, Electron, mobile WebViews).",
  "keywords": [
    "openlfcp",
    "lfcp",
    "local-first",
    "end-to-end-encryption",
    "storage",
    "indexeddb",
    "browser"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/openlfcp/sdk-ts/tree/main/packages/storage-idb#readme",
  "bugs": {
    "url": "https://github.com/openlfcp/sdk-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openlfcp/sdk-ts.git",
    "directory": "packages/storage-idb"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "dependencies": {
    "@openlfcp/core": "workspace:^",
    "@openlfcp/storage": "workspace:^"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5"
  }
}
