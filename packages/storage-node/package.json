{
  "name": "@openlfcp/storage-node",
  "version": "0.5.2",
  "description": "Durable Node.js storage for LFCP clients: SQLite (better-sqlite3) and a file secret store; the headless `lfcp-node pair` command. Node only.",
  "keywords": [
    "openlfcp",
    "lfcp",
    "local-first",
    "end-to-end-encryption",
    "storage",
    "sqlite",
    "node"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/openlfcp/sdk-ts/tree/main/packages/storage-node#readme",
  "bugs": {
    "url": "https://github.com/openlfcp/sdk-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openlfcp/sdk-ts.git",
    "directory": "packages/storage-node"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "lfcp-node": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "dependencies": {
    "@openlfcp/client": "workspace:^",
    "@openlfcp/core": "workspace:^",
    "@openlfcp/crypto": "workspace:^",
    "@openlfcp/shared-objects": "workspace:^",
    "@openlfcp/storage": "workspace:^",
    "@openlfcp/wire": "workspace:^",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.1"
  }
}
