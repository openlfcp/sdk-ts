{
  "name": "@openlfcp/crypto",
  "version": "0.0.0",
  "description": "Thin wrapper over audited primitives (SHA-256, Ed25519, X25519, HKDF, ChaCha20-Poly1305, HPKE) for LFCP; the only package that uses @noble/*.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openlfcp/sdk-ts.git",
    "directory": "packages/crypto"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@openlfcp/core": "workspace:^",
    "@panva/hpke-noble": "^1.1.7",
    "hpke": "^1.1.7"
  }
}
