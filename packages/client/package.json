{
  "name": "@openlfcp/client",
  "version": "0.2.0-beta.2",
  "description": "LFCP client: session, Control Plane and Data Plane synchronization.",
  "keywords": [
    "openlfcp",
    "lfcp",
    "local-first",
    "end-to-end-encryption",
    "sync",
    "client",
    "websocket"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/openlfcp/sdk-ts/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/openlfcp/sdk-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openlfcp/sdk-ts.git",
    "directory": "packages/client"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "dependencies": {
    "@openlfcp/core": "workspace:^",
    "@openlfcp/crypto": "workspace:^",
    "@openlfcp/storage": "workspace:^",
    "@openlfcp/wire": "workspace:^"
  }
}
