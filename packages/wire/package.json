{
  "name": "@openlfcp/wire",
  "version": "0.1.0-rc.1",
  "description": "Deterministic CBOR, COSE and LFCP Wire structures and codecs.",
  "keywords": [
    "openlfcp",
    "lfcp",
    "local-first",
    "end-to-end-encryption",
    "protocol",
    "cbor",
    "cose",
    "wire-format"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/openlfcp/sdk-ts/tree/main/packages/wire#readme",
  "bugs": {
    "url": "https://github.com/openlfcp/sdk-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openlfcp/sdk-ts.git",
    "directory": "packages/wire"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cbor": {
      "types": "./dist/cbor/index.d.ts",
      "import": "./dist/cbor/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "dependencies": {
    "@openlfcp/core": "workspace:^",
    "@openlfcp/crypto": "workspace:^"
  }
}
