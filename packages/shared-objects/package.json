{
  "name": "@openlfcp/shared-objects",
  "version": "0.1.4",
  "description": "SHARED-OBJECTS-PROFILE-01 (org.openlfcp.shared-objects.v1) implementation.",
  "keywords": [
    "openlfcp",
    "lfcp",
    "local-first",
    "end-to-end-encryption",
    "automerge",
    "crdt",
    "tasks",
    "shared-objects"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/openlfcp/sdk-ts/tree/main/packages/shared-objects#readme",
  "bugs": {
    "url": "https://github.com/openlfcp/sdk-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openlfcp/sdk-ts.git",
    "directory": "packages/shared-objects"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "scripts": {
    "test": "cd ../.. && vitest run packages/shared-objects/test/",
    "test:property": "cd ../.. && vitest run packages/shared-objects/test/property/",
    "test:property:extended": "cd ../.. && LFCP_PROPERTY_EXTENDED=1 vitest run packages/shared-objects/test/property/"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "dependencies": {
    "@automerge/automerge": "3.5.0",
    "@openlfcp/core": "workspace:^",
    "@openlfcp/crypto": "workspace:^",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  }
}
