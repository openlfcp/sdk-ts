{
  "name": "openlfcp-sdk-ts",
  "version": "0.0.0",
  "private": true,
  "description": "Reusable TypeScript LFCP implementation (workspace root, not published).",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:conformance": "vitest run conformance/",
    "lint": "biome check . && node scripts/check-boundaries.mjs && node scripts/check-boundaries.mjs --self-test",
    "format": "biome check --write .",
    "release:check": "node scripts/release-check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@openlfcp/client": "workspace:*",
    "@openlfcp/core": "workspace:*",
    "@openlfcp/crypto": "workspace:*",
    "@openlfcp/shared-objects": "workspace:*",
    "@openlfcp/storage": "workspace:*",
    "@openlfcp/storage-idb": "workspace:*",
    "@openlfcp/storage-node": "workspace:*",
    "@openlfcp/wire": "workspace:*",
    "@panva/hpke-noble": "^1.1.7",
    "hpke": "^1.1.7",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
